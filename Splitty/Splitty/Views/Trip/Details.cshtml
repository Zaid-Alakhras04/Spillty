@model Split.Core.Entities.Trip

@{
    ViewData["Title"] = Model.Name + " - Details";
}

<div class="container mt-5">
    <div class="row align-items-center mb-4">
        <div class="col">
            <a href="/Trip/Index" class="btn btn-sm btn-outline-secondary mb-2">&larr; Back to Dashboard</a>

            <div class="d-flex align-items-center mb-2">
                <h1 class="display-5 fw-bold text-dark mb-0">@Model.Name</h1>
                <button class="btn btn-outline-success fw-bold rounded-pill px-4 ms-3" data-bs-toggle="modal" data-bs-target="#shareTripModal">
                    ✉️ Share Summary
                </button>
            </div>

            <p class="text-muted fs-5 mb-2 d-flex align-items-center">
                <span class="me-2">Group Members: @string.Join(", ", Model.Members.Select(m => m.Name))</span>
                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#addMemberModal">
                    + Add Person
                </button>
            </p>

            @{
                decimal tripTotal = Model.Expense != null ? Model.Expense.Sum(e => e.Amount) : 0;
            }

            <h4 class="fw-boldtext-success mt-2 ">
                Total Trip Cost: $@tripTotal.ToString("0.00")
            </h4>



        </div>
        <div class="col-auto">
            <button class="btn btn-success btn-lg rounded-pill shadow-sm fw-bold px-4" onclick="openExpenseModal()">
                + Add an Expense
            </button>
        </div>
    </div>

    <!-- CURRENT BALANCES SECTION -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-light">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-4">Current Balances</h4>
            <div class="row">
                @foreach (var member in Model.Members)
                {
                    var totalPaid = Model.Expense != null
                    ? Model.Expense.Where(e => e.MemberId == member.Id).Sum(e => e.Amount) : 0;
                    var totalOwed = Model.Expense != null
                    ? Model.Expense.SelectMany(e => e.Shares).Where(s => s.MemberId == member.Id).Sum(s => s.OwnedAmount) : 0;
                    var balance = totalPaid - totalOwed;

                    <div class="col-md-4 mb-3">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body text-center py-4">
                                <h5 class="fw-bold text-dark mb-2">@member.Name</h5>
                                @if (balance > 0)
                                {
                                    <span class="text-success fw-bold fs-5">+ $@balance.ToString("0.00")</span>
                                }
                                else if (balance < 0)
                                {
                                    <span class="text-danger fw-bold fs-5">- $@Math.Abs(balance).ToString("0.00")</span>
                                }
                                else
                                {
                                    <span class="text-muted fw-bold fs-5">Settled Up</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- NEW: HOW TO SETTLE UP SECTION -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-light">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-4">How to Settle Up</h4>
            @if (ViewBag.Settlements != null && ((IEnumerable<dynamic>)ViewBag.Settlements).Any())
            {
                <ul class="list-group list-group-flush rounded border">
                    @foreach (var settlement in ViewBag.Settlements)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center bg-white p-3">
                            <span class="fs-5"><strong>@settlement.FromName</strong> owes <strong>@settlement.ToName</strong></span>
                            <span class="badge bg-success rounded-pill fs-6 px-3 py-2">$@settlement.Amount.ToString("0.00")</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted fs-5 mb-0">Everyone is perfectly settled up!</p>
            }
        </div>
    </div>

    <!-- EXPENSE HISTORY SECTION -->
    <div class="card border-0 shadow-sm rounded-4 mb-5">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-4">Expense History</h4>

            @if (Model.Expense == null || !Model.Expense.Any())
            {
                <div class="text-center py-4 text-muted">
                    <p class="mb-0 fs-5">No expenses logged yet. Add your first bill to start splitting!</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Description</th>
                                <th>Paid By</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var expense in Model.Expense)
                            {
                                var payerName = Model.Members.FirstOrDefault(m => m.Id == expense.MemberId)?.Name ?? "Unknown";

                                <tr>
                                    <td class="fw-bold">@expense.Name</td>
                                    <td>@payerName</td>
                                    <td class="text-danger fw-bold">$@expense.Amount.ToString("0.00")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-5">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0">Receipt Gallery</h4>
            <button class="btn btn-outline-primary btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#uploadReceiptModal">
                📷 Upload Photo
            </button>
        </div>

        @if (Model.Images == null || !Model.Images.Any())
        {
            <div class="text-center py-4 text-muted">
                <p class="mb-0 fs-5">No receipts uploaded yet.</p>
            </div>
        }
        else
        {
            <div class="row row-cols-2 row-cols-md-4 g-3">
                @foreach (var image in Model.Images)
                {
                    <div class="col">
                        <div class="card border-0 shadow-sm h-100 overflow-hidden rounded-3">
                            <!-- Click to open full size in new tab -->
                            <a href="@image.ImagePath" target="_blank">
                                <img src="@image.ImagePath" class="img-fluid w-100" style="object-fit: cover; height: 150px;" alt="Receipt">
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- ADD EXPENSE MODAL -->
<div class="modal fade" id="addExpenseModal" tabindex="-1" aria-hidden="true" style="background: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header bg-success text-white border-0 px-4 pt-4">
                <h5 class="modal-title fw-bold">Log a New Expense</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- Removed old onclick submit methods, relying on standard form submission -->
            <form action="/Trip/AddExpense/@Model.Id" method="POST">
                <div class="modal-body p-4">

                    <div class="mb-3">
                        <label class="form-label fw-bold">What was this for?</label>
                        <input type="text" name="description" class="form-control bg-light" placeholder="e.g., Dinner, Gas, Hotel" required />
                    </div>

                    <!-- FIXED: Who Paid Layout -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Who Paid for everyone?</label>
                        <select name="paidById" class="form-select bg-light" required>
                            <option value="">Select person...</option>
                            @foreach (var member in Model.Members)
                            {
                                <option value="@member.Id">@member.Name</option>
                            }
                        </select>
                    </div>

                    <!-- EXACT AMOUNTS INPUTS -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Who bought what? (Enter exact amounts)</label>
                        <div class="p-3 bg-light rounded border">
                            @foreach (var member in Model.Members)
                            {
                                <div class="d-flex align-items-center mb-2">
                                    <label class="form-label mb-0 me-3 fw-semibold" style="width: 120px;">@member.Name</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white">$</span>
                                        <input type="number" step="0.1" min="0" name="memberAmounts[@member.Id]" class="form-control">
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                </div>
                <div class="modal-footer border-0 p-4 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <!-- Ensure type is submit to trigger the POST action -->
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">Save Expense</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- SHARE TRIP MODAL -->
<div class="modal fade" id="shareTripModal" tabindex="-1" aria-hidden="true" style="background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(4px);">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">

            <div class="modal-header border-0 px-4 pt-4">
                <h4 class="modal-title fw-bold text-dark">Share Trip Summary</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form action="/Trip/ShareTrip" method="POST">
                <div class="modal-body p-4">
                    <input type="hidden" name="tripId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary">Friend's Email Address</label>
                        <input type="email" name="email" class="form-control form-control-lg rounded-3 border-light-subtle bg-light" placeholder="name@example.com" required />

                        <small class="text-danger mt-2 d-block fw-bold">
                            *Testing Note: Because you are on the Resend free tier, you can only send emails to your verified account email address.
                        </small>
                    </div>
                </div>

                <div class="modal-footer border-0 p-4 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-link text-secondary text-decoration-none fw-bold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">Send Email</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="addMemberModal" tabindex="-1" aria-hidden="true" style="background: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">

            <div class="modal-header border-0 px-4 pt-4">
                <h5 class="modal-title fw-bold">Add a New Member</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form action="/Trip/AddMember" method="POST">
                <div class="modal-body p-4">

                    <input type="hidden" name="tripId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Member Name</label>
                        <input type="text" name="memberName" class="form-control bg-light" placeholder="e.g., Sarah, Khaled" required />
                    </div>

                </div>
                <div class="modal-footer border-0 p-4 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Add Member</button>
                </div>
            </form>

        </div>
    </div>
</div>

<div class="modal fade" id="uploadReceiptModal" tabindex="-1" aria-hidden="true" style="background: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">

            <div class="modal-header border-0 px-4 pt-4">
                <h5 class="modal-title fw-bold">Upload a Receipt</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- CRUCIAL: enctype="multipart/form-data" is required for file uploads! -->
            <form action="/Trip/UploadReceipt" method="POST" enctype="multipart/form-data">
                <div class="modal-body p-4">

                    <input type="hidden" name="tripId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Image</label>
                        <input type="file" name="receiptImage" class="form-control bg-light" accept="image/*" required />
                    </div>

                </div>
                <div class="modal-footer border-0 p-4 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Upload Image</button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/trip-details.js" asp-append-version="true"></script>
}